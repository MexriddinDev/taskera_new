# ============================================================
# Bootstrap Superadmin (auth_source=LOCAL — faqat bir marta)
# Biror AD foydalanuvchiga Super Admin roli berilgach,
# barcha kirish AD orqali bo'ladi.
# ============================================================
SUPERADMIN_PASSWORD="Admin@2024!"

# ============================================================
# Active Directory (LDAP) ulanish sozlamalari
# ============================================================
# VAQTINCHALIK: login AD (xb.uz, 5.100) o'rniga Exchange AD (adatum.com, 2.161)
# ishlatilmoqda — faqat Exchange'da yaratilgan userlar login qila oladi.
# Eski sozlamalar (qaytarish uchun):
# LDAP_HOST=172.28.5.100
# LDAP_PORT=389
# LDAP_BASE_DN="DC=xb,DC=uz"
# LDAP_SERVICE_USER="adunblock@xb.uz"
# LDAP_SERVICE_PASS="zzzz+123"
LDAP_HOST=172.28.2.161
LDAP_PORT=636
LDAP_BASE_DN="DC=adatum,DC=com"
LDAP_SERVICE_USER="administrator@adatum.com"
LDAP_SERVICE_PASS="zzzz+123"
LDAP_TIMEOUT=5
# OLD: Exchange AD sinovlari (172.28.2.178 - LDAPS/STARTTLS ishlamadi)
#LDAP_HOST=172.28.2.178
#LDAP_PORT=389
#LDAP_BASE_DN="DC=adatum,DC=com"
#LDAP_SERVICE_USER="administrator@adatum.com"
#LDAP_SERVICE_PASS="zzzz+123"
#LDAP_TIMEOUT=5

# ============================================================
# SSO (sso-test.xb.uz) — SMS Gateway uchun xizmat tokeni
# ============================================================
SSO_URL="https://sso-test.xb.uz"
SSO_CLIENT_ID="taskflow_test"
SSO_CLIENT_SECRET="taskflow_test"
SSO_SCOPE="sms_gateway"
SSO_TOKEN_TTL_MINUTES=120
SSO_TOKEN_BUFFER_SECONDS=60
SSO_BYPASS_PROXY=true
# SMS yuborish endpointi (bo'sh bo'lsa kod logga yoziladi)
SMS_SEND_URL="https://sms-test.xb.uz/v1/sms/single-sms-by-template"
SMS_USERNAME="xb_smsbanking"
SMS_PASSWORD="\$m\$b@nk2022"
SMS_TEMPLATE_ID="SYSTEM_VERIFY_CODE"

# Xodimni PINFL bo'yicha tekshirish
CHECK_EMPLOYEE_URL="http://172.28.6.201:8079/check-employee"
CHECK_EMPLOYEE_TIMEOUT=15
CHECK_EMPLOYEE_BYPASS_PROXY=true

# ============================================================
# Exchange (pochta) — AD foydalanuvchi + pochta qutisi yaratish
# ============================================================
EXCHANGE_LDAP_HOST=172.28.2.161
EXCHANGE_LDAP_PORT=636
EXCHANGE_LDAP_BASE_DN="DC=adatum,DC=com"
EXCHANGE_LDAP_USER="administrator@adatum.com"
EXCHANGE_LDAP_PASS="zzzz+123"
EXCHANGE_LDAP_TIMEOUT=5
EXCHANGE_EMAIL_DOMAIN="xb.uz"
# userPrincipalName uchun AD domeni (mail xb.uz bo'lsa ham UPN adatum.com)
EXCHANGE_UPN_DOMAIN="xb.uz"
EXCHANGE_DEFAULT_OU="OU=Headoffice,DC=adatum,DC=com"
EXCHANGE_GROUPS_OU="OU=Headoffice,DC=adatum,DC=com"
EXCHANGE_AUTO_CREATE_GROUPS=true
# BXM kodi → OU (vergul bilan ajratilgan, masalan: 9006:OU=Headoffice,DC=adatum,DC=com)
EXCHANGE_BXM_OU_MAP=""
# Ixtiyoriy: helper PowerShell xizmati (New-Mailbox uchun) — bo'sh bo'lsa LDAP usul ishlaydi
EXCHANGE_MAILBOX_API_URL=""
# Yangi akkauntga "must change password at next logon" (pwdLastSet=0) o'rnatish
EXCHANGE_FORCE_CHANGE_ON_LOGIN=true

VITE_APP_NAME="${APP_NAME}"

SSO_VERIFY_SSL=false
SMS_VERIFY_SSL=false
