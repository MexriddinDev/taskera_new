APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# Active Directory (LDAP) ulanish sozlamalari
# ============================================================
LDAP_HOST=172.28.5.100
LDAP_PORT=389
LDAP_BASE_DN="DC=xb,DC=uz"
LDAP_SERVICE_USER="adunblock@xb.uz"
LDAP_SERVICE_PASS=""
LDAP_TIMEOUT=5

# ============================================================
# SSO (sso-test.xb.uz) — SMS Gateway uchun xizmat tokeni
# ============================================================
SSO_URL="https://sso-test.xb.uz"
SSO_CLIENT_ID="taskflow_test"
SSO_CLIENT_SECRET="taskflow_test"
SSO_SCOPE="sms_gateway"
SSO_TOKEN_TTL_MINUTES=120
SSO_TOKEN_BUFFER_SECONDS=60
# Proxy ortidagi muhitda false qiling
SSO_BYPASS_PROXY=false
# SMS yuborish endpointi (bo'sh bo'lsa kod logga yoziladi)
SMS_SEND_URL="https://sms-test.xb.uz/v1/sms/single-sms-by-template"
SMS_USERNAME="xb_smsbanking"
SMS_PASSWORD=""
SMS_TEMPLATE_ID="SYSTEM_VERIFY_CODE"

# Xodimni PINFL bo'yicha tekshirish
CHECK_EMPLOYEE_URL="http://172.28.6.201:8079/check-employee"
CHECK_EMPLOYEE_TIMEOUT=15
CHECK_EMPLOYEE_BYPASS_PROXY=true

VITE_APP_NAME="${APP_NAME}"
